{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JejuTripBalanceGamePayload",
  "description": "8개 라운드 및 구글 스프레드시트 수신용 JSON 페이로드 명세",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "사용자 세션 식별자 (중복 방지 및 스마트 업데이트용)"
    },
    "name": {
      "type": "string",
      "default": "민아",
      "description": "응답자 이름"
    },
    "timestamp": {
      "type": "string",
      "description": "선택 일시 (한국 시간 KST)"
    },
    "typeBadge": {
      "type": "string",
      "description": "판정된 3대 여행 성향 배지"
    },
    "r1_morning": {
      "type": "string",
      "description": "Round 1: 2일차 오전 서부 해안 첫 출발"
    },
    "r2_lunch": {
      "type": "string",
      "description": "Round 2: 2일차 점심 서부 미식"
    },
    "r3_afternoon": {
      "type": "string",
      "description": "Round 3: 2일차 오후 감성 스팟 & 억새"
    },
    "r4_dinner": {
      "type": "string",
      "description": "Round 4: 2일차 저녁 중문 흑돼지 & 한잔"
    },
    "r5_lunch3": {
      "type": "string",
      "description": "Round 5: 3일차 점심 제주 바다 한상"
    },
    "r6_afternoon3": {
      "type": "string",
      "description": "Round 6: 3일차 오후 온화한 남부 데이트"
    },
    "r7_dinner3": {
      "type": "string",
      "description": "Round 7: 3일차 저녁 회 & 한잔"
    },
    "r8_finale": {
      "type": "string",
      "description": "Round 8: 4일차 피날레 동부 숲길 & 함덕"
    },
    "memo": {
      "type": "string",
      "description": "민아가 마지막에 남긴 특별 코멘트/메모"
    }
  },
  "required": ["sessionId", "timestamp"]
}