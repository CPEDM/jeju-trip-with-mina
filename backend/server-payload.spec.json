{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JejuTripSelectionPayload",
  "description": "민아가 '선택 완료!'를 눌렀을 때 백그라운드에서 전송되는 JSON 페이로드 규격",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "민아",
      "description": "선택자 이름"
    },
    "timestamp": {
      "type": "string",
      "example": "2026. 11. 1. 오후 9:20:15",
      "description": "선택 완료 한국 시각"
    },
    "typeBadge": {
      "type": "string",
      "example": "제1안: 밸런스 정석형 당첨 ✨",
      "description": "최종 판정된 여행 스타일 뱃지"
    },
    "q1_course": {
      "type": "string",
      "example": "새별오름 초입 억새밭 산책 (적당히 걷기)",
      "description": "2일차 토요일 오후 코스"
    },
    "q2_hotel": {
      "type": "string",
      "example": "히든클리프 호텔 (숲속 온수풀 & 중문 5분 복귀)",
      "description": "2~3일차 토·일 호캉스 숙소 픽"
    },
    "q2_food": {
      "type": "string",
      "example": "히든클리프 호텔 (숲속 온수풀 & 중문 5분 복귀)",
      "description": "2~3일차 숙소 (구 스크립트 호환용 키)"
    },
    "q3_food": {
      "type": "string",
      "example": "정갈하고 예쁜 한상 (고집돌우럭 정식 + 깔끔 횟집)",
      "description": "3일차 일요일 서귀포 식당 분위기"
    },
    "q3_vibe": {
      "type": "string",
      "example": "정갈하고 예쁜 한상 (고집돌우럭 정식 + 깔끔 횟집)",
      "description": "3일차 식당 (구 스크립트 호환용 키)"
    },
    "q4_afternoon": {
      "type": "string",
      "example": "쇠소깍 & 휴애리 (물빛 산책 & 동백꽃길 귤따기)",
      "description": "3일차 일요일 남부 오후 감성일정"
    },
    "q5_lastday": {
      "type": "string",
      "example": "함덕 델문도 (바다 바로 앞 탁 트인 오션뷰 물멍)",
      "description": "4일차 월요일 함덕 마무리 & 복귀"
    },
    "memo": {
      "type": "string",
      "example": "소품샵 꼭 들르고 싶어! 저녁엔 딱새우 포장해서 먹자",
      "description": "민아가 직접 입력한 추가 코멘트 및 궁금한 점"
    }
  },
  "required": [
    "name",
    "timestamp",
    "typeBadge",
    "q1_course",
    "q2_food",
    "q3_vibe",
    "q4_afternoon",
    "q5_lastday"
  ]
}